# ============================================================
# apps/backend/.env.example  —  Plantilla (SEGURA para git, sin credenciales)
# Copiá este archivo a .env y completá con tus datos reales.
# NUNCA subas el .env real: contiene passwords / tokens.
# ============================================================
# Cómo conectar la instancia de MongoDB que quieras (MONGODB_URI):
#
#   1) MongoDB local (Docker/MotorMongo en tu máquina):
#      MONGODB_URI=mongodb://localhost:27017/saas-orders
#
#   2) MongoDB Atlas (cluster en la nube):
#      MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU-CLUSTER.mongodb.net/saas-orders?retryWrites=true&w=majority&appName=Cluster0
#      - Database Access: creá un usuario con su password.
#      - Network Access: agregá tu IP actual (o 0.0.0.0/0 para todo).
#      - Reemplazá TU_USUARIO, TU_PASSWORD y el host por los de tu cluster.
#
# Auto-seed: si la base existe pero está VACÍA, al arrancar el backend
# la siembra solo. Seed manual: pnpm --filter @saas/backend seed
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MongoDB Atlas o local)
MONGODB_URI=mongodb://localhost:27017/saas-orders

# JWT — generá un secreto aleatorio largo (ej: openssl rand -hex 32)
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=4h

# CORS: orígenes permitidos separados por coma (frontend web + admin)
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Ubicación del local (para cálculo de distancia de delivery)
STORE_LAT=-34.6037
STORE_LNG=-58.3816

# Mapbox (geocoding y distancia por ruta). Opcional: sin token usa Haversine.
MAPBOX_TOKEN=

# Cloudinary (galería de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Presupuesto mensual de llamadas a geocoding (protección de costo)
GEOCODING_BUDGET_MONTHLY=8000

# Usuario admin que siembra el auto-seed (opcional; por defecto admin@local.dev / admin123)
# SEED_ADMIN_EMAIL=admin@midominio.com
# SEED_ADMIN_PASSWORD=cambiar-este-password