# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MongoDB Atlas o local)
MONGODB_URI=mongodb://localhost:27017/saas-orders

# JWT
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=4h

# CORS: orígenes permitidos separados por coma (frontend web + admin)
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Ubicación del local (para cálculo de distancia de delivery)
STORE_LAT=-34.6037
STORE_LNG=-58.3816

# Mapbox (geocoding y distancia por ruta). Opcional: sin token usa Haversine.
MAPBOX_TOKEN=

# Cloudinary (galería de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Presupuesto mensual de llamadas a geocoding (protección de costo)
GEOCODING_BUDGET_MONTHLY=8000
