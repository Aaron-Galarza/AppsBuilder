{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "index.ts",
    "lib/**/*.ts",
    "components/**/*",
    "layout/**/*",
    "admin/**/*",
    "hooks/**/*"
  ],
  "exclude": ["node_modules", "dist", "styles"]
}
